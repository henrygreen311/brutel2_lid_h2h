{
  "version": "2.0",
  "usage_restriction": "Detection rules for a repo-level secret scanner. Each rule combines a regex (with a capture group identifying the secret) with an optional Shannon-entropy threshold and a keyword pre-filter. Rules are checked against file contents; a keyword hit is only a hint that a rule *might* apply — the regex and entropy gate then decide whether a finding is real. Inspired by gitleaks/trufflehog rule shapes.",
  "settings": {
    "min_entropy": 3.0,
    "max_file_size_kb": 2048,
    "skip_extensions": [
      ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".ico", ".svg",
      ".pdf", ".zip", ".gz", ".tgz", ".tar", ".rar", ".7z", ".bz2", ".xz",
      ".mp3", ".mp4", ".wav", ".ogg", ".mov", ".avi", ".mkv",
      ".woff", ".woff2", ".ttf", ".eot", ".otf",
      ".exe", ".dll", ".so", ".dylib", ".bin", ".class", ".jar", ".war",
      ".pyc", ".pyo", ".o", ".a", ".obj", ".wasm",
      ".lock", ".sum", ".map"
    ],
    "skip_paths": [
      "/.git/", "/node_modules/", "/vendor/", "/dist/", "/build/",
      "/.venv/", "/venv/", "/__pycache__/", "/.mypy_cache/",
      "/target/", "/bin/", "/obj/", "/coverage/", "/.next/", "/.nuxt/"
    ]
  },
  "rules": [
    {
      "id": "aws-access-key-id",
      "description": "AWS Access Key ID",
      "category": "cloud_provider_credentials",
      "risk": "critical",
      "regex": "\\b((?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16})\\b",
      "secret_group": 1,
      "entropy": 0,
      "keywords": ["AKIA", "ASIA", "A3T", "ABIA", "ACCA"],
      "allowlist": { "regexes": ["AKIAIOSFODNN7EXAMPLE", "AKIAI44QH8DHBEXAMPLE"] }
    },
    {
      "id": "aws-secret-access-key",
      "description": "AWS Secret Access Key",
      "category": "cloud_provider_credentials",
      "risk": "critical",
      "regex": "(?i)aws[_\\- ]?(?:secret|access)[_\\- ]?(?:access[_\\- ]?)?key[\"'\\s:=]{1,20}([A-Za-z0-9/+=]{40})",
      "secret_group": 1,
      "entropy": 4.0,
      "keywords": ["aws_secret", "aws-secret", "secret_access_key", "secretaccesskey"]
    },
    {
      "id": "aws-session-token",
      "description": "AWS Session Token",
      "category": "cloud_provider_credentials",
      "risk": "high",
      "regex": "(?i)aws_session_token[\"'\\s:=]{1,10}([A-Za-z0-9/+=]{100,})",
      "secret_group": 1,
      "entropy": 3.5,
      "keywords": ["aws_session_token"]
    },
    {
      "id": "gcp-api-key",
      "description": "Google Cloud API Key",
      "category": "cloud_provider_credentials",
      "risk": "high",
      "regex": "\\b(AIza[0-9A-Za-z\\-_]{35})\\b",
      "secret_group": 1,
      "entropy": 0,
      "keywords": ["AIza"]
    },
    {
      "id": "gcp-service-account",
      "description": "GCP Service Account JSON (private_key_id + private_key block)",
      "category": "cloud_provider_credentials",
      "risk": "critical",
      "regex": "\"type\"\\s*:\\s*\"service_account\"[\\s\\S]{1,4000}?\"private_key\"\\s*:\\s*\"(-----BEGIN PRIVATE KEY-----[^\"]{100,})\"",
      "secret_group": 1,
      "entropy": 0,
      "keywords": ["service_account", "private_key"]
    },
    {
      "id": "azure-storage-account-key",
      "description": "Azure Storage Account Key",
      "category": "cloud_provider_credentials",
      "risk": "critical",
      "regex": "(?i)AccountKey\\s*=\\s*([A-Za-z0-9+/=]{86,90})",
      "secret_group": 1,
      "entropy": 4.0,
      "keywords": ["AccountKey"]
    },
    {
      "id": "azure-connection-string",
      "description": "Azure Service Bus / Storage connection string with SharedAccessKey",
      "category": "cloud_provider_credentials",
      "risk": "critical",
      "regex": "(?i)SharedAccessKey=([A-Za-z0-9+/=]{40,90})",
      "secret_group": 1,
      "entropy": 4.0,
      "keywords": ["SharedAccessKey"]
    },

    {
      "id": "openai-api-key",
      "description": "OpenAI API key",
      "category": "ai_and_ml_api_keys",
      "risk": "high",
      "regex": "\\b(sk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_\\-]{20,200})\\b",
      "secret_group": 1,
      "entropy": 3.5,
      "keywords": ["sk-"],
      "allowlist": { "regexes": ["sk-xxxxxxxx", "sk-your", "sk-REPLACE"] }
    },

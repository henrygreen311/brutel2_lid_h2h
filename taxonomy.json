  "description": "BIP39 keyword trigger (activates repo-wide wordlist scan)",
  "category": "crypto_wallet_secrets",
  "risk": "critical",
  "regex": "(?i)\\b(?:mnemonic|seed[ _-]?phrase|recovery[ _-]?phrase)\\b",
  "secret_group": 0,
  "entropy": 0,
  "keywords": [
    "mnemonic", "seed_phrase", "seed phrase",
    "recovery_phrase", "recovery phrase"
  ]
},

